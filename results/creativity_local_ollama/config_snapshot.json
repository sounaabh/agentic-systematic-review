{
  "llm": {
    "provider": "ollama",
    "model": "qwen2.5:7b",
    "temperature": 0,
    "num_ctx": 8192,
    "screener_b_model": "gemma3:4b",
    "embedding_model": "nomic-embed-text"
  },
  "search": {
    "sources": [
      "openalex",
      "arxiv"
    ],
    "max_results_per_query": 10,
    "max_records_to_screen": 20,
    "year_from": 2020
  },
  "fulltext": {
    "max_studies": 5,
    "chunk_words": 220,
    "chunk_overlap": 40,
    "top_k_chunks": 8
  },
  "workflow": {
    "human_in_the_loop": true,
    "max_critic_revisions": 2,
    "runs_dir": "runs"
  }
}